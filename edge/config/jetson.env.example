# Copy this file outside Git tracking as edge/config/jetson.env when local overrides are needed.
WARDY_CAMERA_DEVICE=/dev/video0
WARDY_CAMERA_WIDTH=640
WARDY_CAMERA_HEIGHT=480
WARDY_CAMERA_FPS=30
WARDY_WEBRTC_BITRATE=2000000
WARDY_WEBRTC_KEYFRAME_INTERVAL=15
WARDY_MEDIAMTX_BIN=mediamtx

# Most USB cameras expose raw YUYV frames. For an MJPEG-only camera, override with:
# WARDY_CAMERA_SOURCE=v4l2src device=/dev/video0 ! image/jpeg,width=640,height=480,framerate=30/1 ! jpegdec
