# Copy this file outside Git tracking as edge/config/jetson.env when local overrides are needed.
WARDY_CAMERA_DEVICE=/dev/video0
WARDY_CAMERA_WIDTH=640
WARDY_CAMERA_HEIGHT=480
WARDY_CAMERA_FPS=30
WARDY_WEBRTC_BITRATE=2000000
WARDY_WEBRTC_KEYFRAME_INTERVAL=15
# The installer places pinned MediaMTX and Caddy binaries under edge/tools.
# WARDY_MEDIAMTX_BIN and WARDY_CADDY_BIN may override those bundled paths.
WARDY_JETSON_HOST=jetson.local
WARDY_TLS_CERTIFICATE=/etc/wardy/tls/jetson.crt
WARDY_TLS_PRIVATE_KEY=/etc/wardy/tls/jetson.key
# The browser opens the UI on its own PC, so the default Origin is localhost.
WARDY_UI_ORIGIN=http://localhost:8000
# Copy this template to edge/config/jetson.env and run chmod 0600 on that file.
# Generate independent high-entropy values and keep them only in jetson.env.
# WARDY_ACCESS_TOKEN authorizes the edge data API.
# WARDY_PUBLISH_TOKEN maps to the loopback-only wardy-publisher account.
WARDY_ACCESS_TOKEN=replace-with-random-api-token
WARDY_PUBLISH_TOKEN=replace-with-random-publisher-token

# M-02 tracking, M-03 pose, and M-04 temporal fall runtime. Model files stay outside Git.
WARDY_ML_VENV=edge/.venv-ml
WARDY_MODEL_ROOT=edge/models
WARDY_POSE_FALL_SOCKET=edge/run/pose-fall.sock
WARDY_DATABASE_PATH=/var/lib/wardy/db/wardy.sqlite
WARDY_TRAINING_DATA_PATH=/var/lib/wardy/training
WARDY_EVENT_MEDIA_PATH=/var/lib/wardy/events
WARDY_BACKUP_PATH=/var/lib/wardy/backups
WARDY_IDENTITY_MATCH_THRESHOLD=0.45
WARDY_IDENTITY_REVIEW_THRESHOLD=0.30
WARDY_HAZARD_MODEL=edge/models/m05_hazard/hazard-objects-c270-finetune-v1/model.onnx
WARDY_HAZARD_CONFIDENCE=0.5
# `auto` publishes real model output when WARDY_PERSON_ENGINE is configured.
# Use `temporary` only to verify downstream UI and event behavior without models.
WARDY_INFERENCE_SOURCE=auto
WARDY_TEMPORARY_INFERENCE_SCENARIO=normal
# Select a non-default registry version when required.
# WARDY_M03_MODEL_VERSION=openmmlab-rtmpose-t-20230504
# WARDY_M04_MODEL_VERSION=wardy-urfd-gru-v1
# Set one of these only when the selected Hugging Face model repository is private.
# HF_TOKEN=hf_replace_with_a_read_only_token
# Use only while installing an unpublished local M-04 artifact directory.
# WARDY_M04_MODEL_SOURCE_DIR=/absolute/private/path/to/m04-artifacts

# The setup script downloads the versioned M-01 checkpoint from Hugging Face,
# exports ONNX in a pinned JetPack 6 container, and builds this TensorRT engine.
WARDY_PERSON_ENGINE=edge/models/m01_person/v1.0.1/model.engine
WARDY_PERSON_CONFIDENCE=0.35
WARDY_PERSON_NMS_IOU=0.45
WARDY_PERSON_CLASS_INDEX=0
# Pinned Ultralytics 8.4.118 JetPack 6 export image.
WARDY_ULTRALYTICS_IMAGE=ultralytics/ultralytics@sha256:ac003d6ea1b127ffcc09113abe288c07854c70bd6f092b31e3667e9ff60ee79b

# On-demand Korean daily summary. Ollama listens on Jetson loopback only.
WARDY_LLM_ENABLED=true
WARDY_LLM_MODEL=nemotron-3-nano:4b
WARDY_LLM_TIMEOUT_SECONDS=30

# Most USB cameras expose raw YUYV frames. For an MJPEG-only camera, override with:
# WARDY_CAMERA_SOURCE=v4l2src device=/dev/video0 ! image/jpeg,width=640,height=480,framerate=30/1 ! jpegdec
