{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wardy.local/schemas/settings.schema.json",
  "title": "Wardy Local Settings",
  "type": "object",
  "required": ["overlay", "notifications", "camera", "jetson", "managed_items", "zones"],
  "properties": {
    "overlay": {
      "type": "object",
      "required": ["showClass", "showRole", "showName", "showPosture"],
      "properties": {
        "showClass": { "type": "boolean" }, "showRole": { "type": "boolean" }, "showName": { "type": "boolean" }, "showPosture": { "type": "boolean" }
      }
    },
    "notifications": {
      "type": "object",
      "properties": {
        "fall_suspected": { "enum": ["off", "on"] },
        "inactivity": { "enum": ["off", "on"] },
        "hazard_detected": { "enum": ["off", "on"] },
        "hazard_proximity": { "enum": ["off", "on"] },
        "zone_entry": { "enum": ["off", "on"] },
        "zone_dwell": { "enum": ["off", "on"] },
        "camera_fault": { "enum": ["off", "on"] },
        "detection_fault": { "enum": ["off", "on"] }
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "required": ["mirrored"],
      "properties": { "mirrored": { "type": "boolean" } },
      "additionalProperties": false
    },
    "jetson": {
      "type": "object",
      "required": ["baseUrl"],
      "properties": {
        "baseUrl": { "type": "string" }
      },
      "additionalProperties": false
    },
    "managed_items": { "type": "array", "items": { "type": "object", "required": ["id", "label", "policy"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "policy": { "enum": ["included", "excluded"] } } } },
    "zones": { "type": "array", "items": { "type": "object", "required": ["id", "name", "x", "y", "width", "height"] } }
  }
}
